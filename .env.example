# Only the chat route reads these. Copy to .env.local for development.
# Use server-side values only; never prefix a key with NEXT_PUBLIC_ or commit keys.
# Free-tier limits, model changes and fallback policy: docs/llm-free-tier-research.md
# Optional re-enable template: Google Gemini's OpenAI-compatible endpoint.
# The deployed chat key is currently ABSENT, so production answers stay local.
# To re-enable remote answers, set LLM_API_KEY, LLM_BASE_URL and LLM_MODEL in
# Vercel with a freshly rotated key, then redeploy. No keys are stored in git.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=replace-with-a-server-side-google-api-key
LLM_MODEL=gemini-3.5-flash-lite

# Chat limits, budgets and consent copy live in src/config/app.json and
# src/content/messages/*.json. Do not configure a paid fallback model.
# Gemini uses submitted content to improve products and logs by default.
# Its free terms restrict consumer use and EEA/Switzerland/UK availability.
