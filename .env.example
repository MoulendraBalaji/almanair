# Only the chat route reads these. Copy to .env.local for development.
# Use server-side values only; never prefix a key with NEXT_PUBLIC_.
# Free-tier limits, model changes and fallback policy: docs/llm-free-tier-research.md
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-with-a-server-side-groq-key
LLM_MODEL=openai/gpt-oss-20b

# Chat limits, budgets and consent copy live in src/config/app.json and
# src/content/messages/*.json. Do not configure a paid fallback model.
