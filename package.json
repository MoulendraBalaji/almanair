{
  "name": "almanair",
  "version": "1.0.0",
  "private": true,
  "description": "On-device winter smog navigator for families and communities",
  "license": "MIT",
  "author": "MoulendraBalaji",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoulendraBalaji/almanair.git"
  },
  "homepage": "https://github.com/MoulendraBalaji/almanair#readme",
  "bugs": {
    "url": "https://github.com/MoulendraBalaji/almanair/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "node scripts/build-index.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "deps": "depcruise --config dependency-cruiser.config.mjs src app",
    "knip": "knip",
    "jscpd": "jscpd --config jscpd.json src app tests scripts",
    "index": "node scripts/build-index.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "budgets": "node scripts/check-budgets.mjs",
    "verify": "npm run index && npm run typecheck && npm run lint && npm run deps && npm run knip && npm run jscpd && npm test && npm run build && npm run budgets"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "dependency-cruiser": "18.8.0",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "jscpd": "5.4.3",
    "jsdom": "31.0.1",
    "knip": "6.46.1",
    "prettier": "3.10.1",
    "server-only": "0.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
