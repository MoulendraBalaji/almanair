{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "middleware.ts",
    "src/infra/sw-register.ts",
    "scripts/*.mjs",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx"
  ],
  "project": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
  "ignore": ["src/data/generated/**", "next-env.d.ts"],
  "ignoreDependencies": ["server-only"],
  "ignoreExportsUsedInFile": true
}
